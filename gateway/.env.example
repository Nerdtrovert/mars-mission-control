# ==============================================================================
# Raspberry Pi 4 Hardware Gateway Configuration Example (gateway/.env.example)
#
# Pi gateway serial settings. Copy to 'gateway/.env' when no root '.env' exists,
# or configure the gateway variables in root '.env'. When started at repository
# root, root '.env' is loaded first; shell variables take precedence.
# ==============================================================================

# USB Serial Device Node for ESP32 Lander (e.g. /dev/ttyUSB0 or /dev/ttyACM0)
GATEWAY_SERIAL_PORT=/dev/ttyUSB0

# Serial Baud Rate (must match ESP32 v1.3.1 firmware: 115200 8N1)
GATEWAY_BAUD_RATE=115200

# Telemetry Staleness Timeout in seconds
GATEWAY_STALE_TIMEOUT_S=3.0

# Lander Offline Timeout in seconds (triggers gate state reversion to UNKNOWN)
GATEWAY_OFFLINE_TIMEOUT_S=5.0

# Maximum wait time for command_ack from ESP32 over serial
GATEWAY_COMMAND_TIMEOUT_S=2.0

# Backoff retry delay when reconnecting USB serial port
GATEWAY_RECONNECT_DELAY_S=1.0
