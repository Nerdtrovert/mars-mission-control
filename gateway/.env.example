# ==============================================================================
# Raspberry Pi 4 Hardware Gateway Configuration Example (gateway/.env.example)
# ==============================================================================

# Lander ESP32 connects to the Pi over the private LAN using newline-delimited JSON/TCP.
LANDER_TCP_HOST=0.0.0.0
LANDER_TCP_PORT=5006

# Telemetry Staleness Timeout in seconds
GATEWAY_STALE_TIMEOUT_S=3.0

# Lander Offline Timeout in seconds.
GATEWAY_OFFLINE_TIMEOUT_S=5.0

# Maximum wait time for command_ack from ESP32 over Wi-Fi TCP
GATEWAY_COMMAND_TIMEOUT_S=2.0

# Backoff between lander TCP accept/recovery attempts
LANDER_RECONNECT_DELAY_S=1.0

# Separate UDP listener for rover GUI broadcasts; does not use/open the rover COM port.
ROVER_UDP_HOST=0.0.0.0
ROVER_UDP_PORT=5005
ROVER_OFFLINE_TIMEOUT_S=2.0

# Separate UDP listener for drone telemetry.
DRONE_UDP_HOST=0.0.0.0
DRONE_UDP_PORT=5007
DRONE_OFFLINE_TIMEOUT_S=5.0
