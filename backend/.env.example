# MacBook backend settings only. Copy to backend/.env when no root .env is
# present; an existing root .env is loaded first when starting at repository root.
# Existing shell variables take precedence over values loaded from .env.
# Operating Mode: "simulator" (default) or "network" ("real")
GATEWAY_MODE=simulator

# Raspberry Pi Gateway REST API Base URL (used when GATEWAY_MODE=network)
GATEWAY_HTTP_URL=http://127.0.0.1:8001

# Raspberry Pi Gateway WebSocket URL (optional: defaults to ws://<host>:<port>/ws/telemetry)
GATEWAY_WS_URL=ws://127.0.0.1:8001/ws/telemetry

# SQLite Database Storage Location
MISSION_DB_PATH=data/mission_control.db
