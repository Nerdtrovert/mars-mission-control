# ==============================================================================
# Mars Mission Control — Environment Configuration Example (.env.example)
#
# Combined reference for backend and gateway environment settings.
# On the MacBook, use backend/.env.example for backend-only settings.
# On the Pi, use gateway/.env.example for gateway-only serial settings.
# When an app starts from the repository root, root '.env' is checked before
# the component-specific .env path. Existing shell variables take precedence.
# Actual '.env' files are excluded from git tracking.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MACBOOK MISSION CONTROL BACKEND CONFIGURATION
# ------------------------------------------------------------------------------

# Operating Mode:
#   "simulator" (Default) -> Runs deterministic in-memory lander & gateway simulator.
#                            Safe for local testing, CI, and hardware-free development.
#   "network" (or "real") -> Connects across local Wi-Fi/Ethernet to the Raspberry Pi
#                            Hardware Gateway daemon for live exhibition operations.
GATEWAY_MODE=simulator

# Raspberry Pi Gateway HTTP REST Endpoint (used when GATEWAY_MODE=network):
# Replace 127.0.0.1 with the static or DHCP IP address of the Raspberry Pi.
GATEWAY_HTTP_URL=http://127.0.0.1:8001

# Raspberry Pi Gateway WebSocket Stream Endpoint (used when GATEWAY_MODE=network):
# Optional: if omitted or empty, automatically derived from GATEWAY_HTTP_URL.
GATEWAY_WS_URL=ws://127.0.0.1:8001/ws/telemetry

# Rover mode is independent of GATEWAY_MODE: simulator or network.
ROVER_MODE=simulator

# SQLite Database Storage File Path:
# Local path where telemetry sliding history, mission events, and command audits are kept.
MISSION_DB_PATH=data/mission_control.db


# ------------------------------------------------------------------------------
# 2. RASPBERRY PI 4 HARDWARE GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------

# USB Serial Device Path:
# The device node assigned to the ESP32 lander microcontroller.
# Common values on Raspberry Pi OS:
#   /dev/ttyUSB0 (CP2102 / CH340 USB-UART bridges)
#   /dev/ttyACM0 (Native USB CDC / ESP32-S3)
# Both SERIAL_PORT and GATEWAY_SERIAL_PORT are recognized.
GATEWAY_SERIAL_PORT=/dev/ttyUSB0

# Serial Baud Rate:
# Must match the frozen ESP32 v1.3.1 firmware baseline (115200 baud, 8N1).
# Both BAUD_RATE and GATEWAY_BAUD_RATE are recognized.
GATEWAY_BAUD_RATE=115200

# Telemetry Silence Thresholds (in seconds):
# Stale threshold: time before lander telemetry is flagged STALE.
GATEWAY_STALE_TIMEOUT_S=3.0

# Offline threshold: time before silent lander is declared OFFLINE and gate state reverts to UNKNOWN.
GATEWAY_OFFLINE_TIMEOUT_S=5.0

# Serial Command Timeout (in seconds):
# Maximum duration to await correlated command_ack from the microcontroller over serial.
GATEWAY_COMMAND_TIMEOUT_S=2.0

# Serial Port Reconnect Delay (in seconds):
# Interval between background serial port reopening attempts when USB cable is unplugged.
GATEWAY_RECONNECT_DELAY_S=1.0

# Pi UDP listener for rover GUI telemetry (separate from lander USB serial).
ROVER_UDP_HOST=0.0.0.0
ROVER_UDP_PORT=5005
