# ==============================================================================
# Mars Mission Control — Full Hardware Network Mode (.env.network)
# ==============================================================================
# Physical devices for ALL subsystems:
# - Lander ESP32 via Pi Wi-Fi TCP port 5006
# - Rover ESP32 via Windows Tkinter GUI UDP port 5005
# - Drone ESP32 client via UDP port 5007
# ==============================================================================

GATEWAY_MODE=network
ROVER_MODE=network
DRONE_MODE=network
FORWARD_SIMULATED_UDP=false

GATEWAY_HTTP_URL=http://192.168.50.1:8001
GATEWAY_WS_URL=ws://192.168.50.1:8001/ws/telemetry
MISSION_DB_PATH=data/mission_control.db
