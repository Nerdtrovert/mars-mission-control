# ==============================================================================
# Mars Mission Control — Hybrid Exhibition Mode (.env.hybrid)
# ==============================================================================
# Real Lander ESP32 & Raspberry Pi Gateway + Simulated Rover & Drone.
# Simulated rover and drone packets are forwarded to the Pi over UDP
# so both the web dashboard and physical Lander ESP32 LCD display live active stats.
# ==============================================================================

GATEWAY_MODE=network
ROVER_MODE=simulator
DRONE_MODE=simulator
FORWARD_SIMULATED_UDP=true

GATEWAY_HTTP_URL=http://192.168.50.1:8001
GATEWAY_WS_URL=ws://192.168.50.1:8001/ws/telemetry
MISSION_DB_PATH=data/mission_control.db
